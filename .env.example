# ---------------------------------------------------------------------------
# Wymagane
# ---------------------------------------------------------------------------

# Token, ktorym klient MCP uwierzytelnia sie na /api/mcp.
# Bez niego serwer na produkcji odmawia obslugi (nie wystawia otwartego endpointu).
# Wygeneruj np.: openssl rand -hex 32
MCP_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Konta Vinted (JSON)
# ---------------------------------------------------------------------------
# accessToken to wartosc ciasteczka `access_token_web` z przegladarki
# zalogowanej na Vinted. Logujesz sie recznie - serwer nigdy nie prosi o haslo
# i nigdy go nie przechowuje. Token wygasa; wtedy podmien go tutaj.
#
# csrfToken (opcjonalny) - niektore akcje zapisu go wymagaja; jest w zrodle
# strony Vinted w <meta name="csrf-token" content="...">.
#
# VINTED_ACCOUNTS=[{"id":"main","label":"Moj sklep","accessToken":"...","csrfToken":"...","userId":12345678}]
VINTED_ACCOUNTS=[]

# Domena rynku, na ktorym dzialasz.
VINTED_DOMAIN=www.vinted.pl

# ---------------------------------------------------------------------------
# Trwaly magazyn (wymagany, zeby monitoring dzialal miedzy wywolaniami)
# ---------------------------------------------------------------------------
# Upstash Redis - na Vercel dodajesz go jako integracje, zmienne wstawia sam.
# Bez nich serwer dziala, ale lista obserwowanych i wykryte przedmioty gina
# po kazdym wywolaniu funkcji.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Vercel wysyla ten sekret w naglowku Authorization przy wywolaniu crona.
# Ustaw, zeby nikt z zewnatrz nie mogl recznie odpalac przebiegu monitoringu.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Automatyczne akcje (polubienie / oferta na nowych przedmiotach)
# ---------------------------------------------------------------------------
# Glowny wylacznik. Dopoki nie jest "true", cron niczego nie wysyla, nawet
# jesli sprzedawca ma ustawione auto_like / auto_offer.
AUTO_ACTIONS_ENABLED=false

# Ponizsze limity to WARTOSCI DOMYSLNE. Kazdy mozesz zmienic w locie, osobno
# dla kazdego konta, narzedziem set_automation_limits - bez redeployu.
# 0 wylacza dana akcje.

# Maks. polubien na dobe (liczone od polnocy UTC).
MAX_LIKES_PER_DAY=30
# Maks. ofert cenowych na dobe.
MAX_OFFERS_PER_DAY=10
# Maks. automatycznych akcji na godzine; nadmiar czeka w kolejce.
MAX_ACTIONS_PER_HOUR=6
# Godziny, w ktorych automat moze dzialac (czas lokalny). "22-6" tez dziala,
# "0-0" oznacza cala dobe.
ACTIVE_HOURS=8-22
ACTIVE_TIMEZONE=Europe/Warsaw
# Na ile godzin automat sie wstrzymuje, gdy Vinted odmowi (403/429/captcha).
AUTOPAUSE_HOURS=24

# Webhook powiadomien o nowych znaleziskach (Discord, Slack lub dowolny
# odbiornik JSON). Opcjonalny.
NOTIFY_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Strojenie (opcjonalne, wartosci ponizej to domyslne)
# ---------------------------------------------------------------------------

# O ile procent ponizej ceny wywolawczej liczona jest oferta negocjacyjna.
# Tez zmienisz w locie przez set_automation_limits (discount_pct).
OFFER_DISCOUNT_PCT=20

# Minimalny odstep miedzy zapytaniami do Vinted, w milisekundach.
# To uprzejmosc wobec cudzego API, nie maskowanie ruchu.
VINTED_MIN_REQUEST_INTERVAL_MS=1200

# Ile razy ponowic nieudane zapytanie (429 / 5xx) z narastajacym odstepem.
VINTED_MAX_RETRIES=2

# Ile najnowszych ofert pobierac od kazdego obserwowanego sprzedawcy.
MONITOR_PAGE_SIZE=20

# Naglowek User-Agent. Identyfikuje klienta uczciwie - nie podszywaj sie
# pod przegladarke.
# VINTED_USER_AGENT=vinted-seller-mcp/1.0 (+https://github.com/andrzej304074-max/12)
